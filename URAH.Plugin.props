<Project>
  <!--
    Common build settings of the URAH BepInEx plugins. A plugin's csproj finds this folder as
    URAHShared (the workspace's shared/ when it exists, else the submodule external/URAH_shared)
    and imports this file. URAHModLink=true compiles ModLink.cs into the plugin.
    Game and loader assemblies are referenced from the local install, never copied or redistributed;
    GameDir defaults to the Steam install on Linux.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameDir Condition="'$(GameDir)' == ''">$(HOME)/.steam/steam/steamapps/common/Knights of Honor II</GameDir>
    <!-- Without a game (CI) or with URAHUseRefs=true: reference assemblies (method bodies stripped)
         from URAHRefs, by default refs/ of the knowledge workspace (tools/make_refs.sh) -->
    <URAHRefs Condition="'$(URAHRefs)' == ''">$(MSBuildThisFileDirectory)../refs</URAHRefs>
    <URAHUseRefs Condition="'$(URAHUseRefs)' == '' and !Exists('$(GameDir)/Sovereign_Data/Managed')">true</URAHUseRefs>
    <ManagedDir Condition="'$(URAHUseRefs)' != 'true'">$(GameDir)/Sovereign_Data/Managed</ManagedDir>
    <BepInExCore Condition="'$(URAHUseRefs)' != 'true'">$(GameDir)/BepInEx/core</BepInExCore>
    <ManagedDir Condition="'$(URAHUseRefs)' == 'true'">$(URAHRefs)/Managed</ManagedDir>
    <BepInExCore Condition="'$(URAHUseRefs)' == 'true'">$(URAHRefs)/BepInEx</BepInExCore>
    <BepInExPlugins>$(GameDir)/BepInEx/plugins</BepInExPlugins>
  </PropertyGroup>

  <!--
    Reproducible builds: the same commit, SDK (global.json) and game version give the same DLL bytes
    on every machine, so anyone can rebuild a release and compare its SHA-256. No machine paths (no
    PDB, source paths mapped), no commit id or date in the version.
  -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>none</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=/_/plugin,$(MSBuildThisFileDirectory)=/_/shared/</PathMap>
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Single version source: plugin/version.txt (one line, e.g. 0.26.0). It becomes the assembly
    version and the constant URAH.BuildVersion.Value for [BepInPlugin]; a release bumps that one line.
  -->
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/version.txt')">
    <URAHVersion>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/version.txt').Trim())</URAHVersion>
    <Version>$(URAHVersion)</Version>
    <AssemblyVersion>$(URAHVersion)</AssemblyVersion>
    <FileVersion>$(URAHVersion)</FileVersion>
    <InformationalVersion>$(URAHVersion)</InformationalVersion>
  </PropertyGroup>

  <Target Name="URAHVersion" BeforeTargets="CoreCompile" Condition="'$(URAHVersion)' != ''">
    <PropertyGroup>
      <URAHVersionFile>$(IntermediateOutputPath)Version.g.cs</URAHVersionFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(URAHVersionFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="// generated from version.txt;namespace URAH { internal static class BuildVersion { public const string Value = &quot;$(URAHVersion)&quot;%3B } }" />
    <ItemGroup>
      <Compile Include="$(URAHVersionFile)" />
      <FileWrites Include="$(URAHVersionFile)" />
    </ItemGroup>
  </Target>

  <ItemGroup Condition="'$(URAHModLink)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)ModLink.cs" Link="Shared/ModLink.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepInExCore)/BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCore)/0Harmony.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(ManagedDir)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="Assembly-CSharp-firstpass" HintPath="$(ManagedDir)/Assembly-CSharp-firstpass.dll" Private="false" />
  </ItemGroup>
</Project>
